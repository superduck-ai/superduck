{
  "name": "superduck-chrome-crx",
  "private": true,
  "version": "1.0.4",
  "type": "module",
  "scripts": {
    "dev": "vite build --watch",
    "dev:local": "vite --host 127.0.0.1",
    "build": "bun scripts/build.mjs chrome",
    "build:chrome": "bun scripts/build.mjs chrome",
    "build:edge": "bun scripts/build.mjs edge",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "lint:ci": "eslint \"src/**/*.{ts,tsx}\" --max-warnings=0",
    "lint:fix": "bun run lint -- --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,json}\" \"eslint.config.js\" \"package.json\" \"tsconfig.json\" \".prettierrc.json\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,json}\" \"eslint.config.js\" \"package.json\" \"tsconfig.json\" \".prettierrc.json\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run tests/integration",
    "test:coverage": "vitest run --coverage",
    "test:perf": "vitest run --reporter=verbose --reporter=junit --outputFile.junit=test-results.junit.xml",
    "test:perf:report": "node scripts/test-perf-report.mjs test-results.junit.xml",
    "test:e2e": "bun x playwright test --config e2e/playwright.config.ts",
    "test:e2e:ui": "bun x playwright test --config e2e/playwright.config.ts --ui",
    "models:refresh": "bun scripts/update-openrouter-models.mjs",
    "docs": "typedoc --options typedoc.json",
    "docs:check": "typedoc --options typedoc.json --emit none"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.95.1",
    "@base-ui/react": "^1.6.0",
    "@fontsource-variable/noto-sans": "^5.2.10",
    "@honeycombio/opentelemetry-web": "^1.1.0",
    "@opentelemetry/api": "^1.9.0",
    "@sentry/browser": "^10.22.0",
    "@tanstack/react-virtual": "^3.13.23",
    "@tiptap/core": "^3.23.1",
    "@tiptap/extension-placeholder": "^3.20.0",
    "@tiptap/pm": "^3.23.1",
    "@tiptap/react": "^3.20.0",
    "@tiptap/starter-kit": "^3.20.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.0",
    "cmdk": "^1.1.1",
    "diff": "^9.0.0",
    "framer-motion": "^12.38.0",
    "katex": "^0.16.33",
    "lucide-react": "^1.17.0",
    "openai": "6.38.0",
    "react": "^19.2.4",
    "react-calendar": "^6.0.1",
    "react-dom": "^19.2.4",
    "react-intl": "^10.1.11",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.1",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "shadcn": "^4.13.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.0.0-beta.33",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.52.0",
    "@tailwindcss/vite": "4.3.0",
    "@types/chrome": "^0.1.37",
    "@types/diff": "^8.0.0",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.3",
    "@types/react-syntax-highlighter": "15.5.13",
    "@vitejs/plugin-react": "^5.1.4",
    "@vitest/coverage-v8": "^4.1.5",
    "eslint": "^10.0.2",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.3.0",
    "prettier": "^3.8.1",
    "tailwindcss": "4.3.0",
    "typedoc": "^0.28.19",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1",
    "unified": "^11.0.5",
    "vite": "^7.3.1",
    "vitest": "^4.1.5"
  },
  "description": "",
  "main": "eslint.config.js",
  "directories": {
    "doc": "docs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arthur-zhang/klaude-crx.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/arthur-zhang/klaude-crx/issues"
  },
  "homepage": "https://github.com/arthur-zhang/klaude-crx#readme"
}
